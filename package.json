{
  "name": "kidock",
  "private": true,
  "version": "0.1.0",
  "description": "Kidock — the dock where your agents' work arrives.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc && vite build",
